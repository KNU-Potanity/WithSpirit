    atlasWidth: 2048
    atlasHeight: 2048
    characterSetSelectionMode: 7
    characterSequence: "# \uC2A4\uD0EF \uAE30\uD68D\uC11C\r\n## 0. \uBB38\uC11C \uBAA9\uC801\r\n>
      \uB9C8\uC9C0\uB9C9 \uC218\uC815\uC77C: 2026-08-18 (2.2\uC808 \uC124\uBA85 \uBB38\uAD6C
      \"\uB9C8\uCEE4\uB85C \uC120\uD0DD\uB41C \uBAAC\uC2A4\uD130\" \u2192 \"\uACF5\uACA9\uD55C
      \uBAAC\uC2A4\uD130\"\uB85C \uC218\uC815 \u2014 ver29)\r\n\uD655\uC7A5 \uB2E8\uACC4\uC5D0\uC11C
      \uB4F1\uC7A5\uD558\uB294 \uD50C\uB808\uC774\uC5B4\xB7\uC815\uB839\xB7\uBAAC\uC2A4\uD130\uC758
      \uC2A4\uD0EF **\uD56D\uBAA9 \uBC0F \uC218\uCE58**\uB97C \uC815\uB9AC\uD569\uB2C8\uB2E4.\r\n2026-07-14
      \uAC1C\uC815: \uAE30\uC874\uC5D0 \"(\uCD94\uD6C4 \uD655\uC815)\"\uC73C\uB85C
      \uBE44\uC6CC\uB450\uC5C8\uB358 \uC815\uB839\xB7\uBAAC\uC2A4\uD130 \uD56D\uBAA9\uC5D0
      \uC2E4\uC81C \uC218\uCE58\uB97C \uCC44\uC6E0\uC2B5\uB2C8\uB2E4. \uC544\uB798
      \uC218\uCE58\uB294 1\uCC28 \uBC38\uB7F0\uC2A4 \uAE30\uC900\uAC12\uC774\uBA70,
      \uD50C\uB808\uC774 \uD14C\uC2A4\uD2B8(`QA_\uD14C\uC2A4\uD2B8_\uACC4\uD68D\uC11C.md`
      9\uC7A5 E-01~E-15) \uACB0\uACFC\uC5D0 \uB530\uB77C \uC870\uC815\uB420 \uC218
      \uC788\uC2B5\uB2C8\uB2E4.\r\n---\r\n## 1. \uD50C\uB808\uC774\uC5B4\r\n| \uC2A4\uD0EF
      | \uC124\uBA85 |\r\n|---|---|\r\n| \uC810\uD504\uB825 | `\uCE90\uB9AD\uD130\uCEE8\uD2B8\uB864_\uC2A4\uD399.md`\uC758
      \uC810\uD504 \uC2A4\uD399\uACFC \uC5F0\uACB0 |\r\n| \uC774\uB3D9 \uC18D\uB3C4
      | `\uCE90\uB9AD\uD130\uCEE8\uD2B8\uB864_\uC2A4\uD399.md`\uC758 \uC774\uB3D9
      \uC2A4\uD399\uACFC \uC5F0\uACB0 |\r\n| \uCCB4\uB825 | \uD558\uD2B8 \uB2E8\uC704\uB85C
      \uD45C\uC2DC. \uB099\uC0AC\uB97C \uC81C\uC678\uD55C \uB370\uBBF8\uC9C0\uB294
      \uD558\uD2B8 1\uC529 \uAC10\uC18C (`\uC6D4\uB4DC_\uC2A4\uD14C\uC774\uC9C0_\uAD6C\uC131.md`
      6\uC7A5 \uCC38\uACE0) |\r\n---\r\n## 2. \uC815\uB839\r\n### 2.1 \uAE30\uBCF8
      \uC815\uB839\r\n| \uC2A4\uD0EF | \uC218\uCE58 |\r\n|---|---|\r\n| \uACF5\uACA9\uB825
      | 1 (2026-07-30 \uC2E4\uC81C \uC5D0\uC14B `MainFairyData.asset` \uAC12\uC73C\uB85C
      \uC218\uC815) |\r\n| \uCFE8\uD0C0\uC784 | 0.5\uCD08 (2026-07-30 \uC2E4\uC81C
      \uC5D0\uC14B `MainFairyData.asset` \uAC12 \uAE30\uC900\uC73C\uB85C \uC218\uC815)
      |\r\n| \uD50C\uB7AB\uD3FC \uD06C\uAE30 | 2.0 \xD7 0.3 \uC720\uB2DB (\uD50C\uB808\uC774\uC5B4
      1\uD68C \uCC29\uC9C0 \uAC00\uB2A5\uD55C \uD3ED) |\r\n| \uD50C\uB7AB\uD3FC \uC885\uB958
      | \uBC84\uD504 \uC5C6\uB294 \uC77C\uBC18 \uBC1C\uD310\uD615 1\uC885 (\uCD94\uAC00
      \uC815\uB839\uC758 \uD50C\uB7AB\uD3FC \uD2B9\uD654 \uD6A8\uACFC \uC5C6\uC74C)
      |\r\n### 2.2 \uACF5\uACA9 \uD2B9\uD654 \uC815\uB839 (2026-08-18 \uAC1C\uBCC4
      \uC218\uCE58 \uD655\uC815: \uD3ED\uBC1C/\uD654\uC0C1/\uBE59\uACB0)\r\n####
      \uD3ED\uBC1C \uC815\uB839 \u2014 \uC8FC\uD669\uC0C9\r\n| \uC2A4\uD0EF | \uC218\uCE58
      |\r\n|---|---|\r\n| \uACF5\uACA9\uB825 | 1 |\r\n| \uCFE8\uD0C0\uC784 | 1 |\r\n|
      \uBC94\uC704 | 3 (\uACF5\uACA9\uD55C \uBAAC\uC2A4\uD130 \uAE30\uC900 3\xD73
      \uBC94\uC704 \uB0B4 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uB370\uBBF8\uC9C0) |\r\n|
      \uC0C1\uD0DC\uC774\uC0C1 \uD6A8\uACFC \uBD80\uC5EC | \uC5C6\uC74C |\r\n> \uC124\uBA85:
      \uACF5\uACA9\uD55C \uBAAC\uC2A4\uD130\uB97C \uAE30\uC900\uC73C\uB85C \uAD11\uC5ED
      \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4.\r\n#### \uD654\uC0C1 \uC815\uB839
      \u2014 \uBE68\uAC04\uC0C9\r\n| \uC2A4\uD0EF | \uC218\uCE58 |\r\n|---|---|\r\n|
      \uACF5\uACA9\uB825 | 0 |\r\n| \uCFE8\uD0C0\uC784 | 1.5 |\r\n| \uBC94\uC704
      | 1 |\r\n| \uC0C1\uD0DC\uC774\uC0C1 \uD6A8\uACFC \uBD80\uC5EC | \uD654\uC0C1
      (\uC0C1\uC138 \uC218\uCE58\uB294 4.2\uC808 \uCC38\uACE0) |\r\n> \uC124\uBA85:
      \uACF5\uACA9\uD55C \uBAAC\uC2A4\uD130\uC5D0\uAC8C 2\uCD08\uB9C8\uB2E4 1\uB370\uBBF8\uC9C0\uB97C
      \uC785\uD788\uB294 \uD654\uC0C1 \uD6A8\uACFC\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4.\r\n####
      \uBE59\uACB0 \uC815\uB839 \u2014 \uD30C\uB780\uC0C9\r\n| \uC2A4\uD0EF | \uC218\uCE58
      |\r\n|---|---|\r\n| \uACF5\uACA9\uB825 | 0 |\r\n| \uCFE8\uD0C0\uC784 | 1 |\r\n|
      \uBC94\uC704 | 1 |\r\n| \uC0C1\uD0DC\uC774\uC0C1 \uD6A8\uACFC \uBD80\uC5EC
      | \uBE59\uACB0 (\uC0C1\uC138 \uC218\uCE58\uB294 4.3\uC808 \uCC38\uACE0) |\r\n>
      \uC124\uBA85: \uACF5\uACA9\uD55C \uBAAC\uC2A4\uD130\uC5D0\uAC8C 3\uCD08\uB3D9\uC548
      \uC774\uB3D9 \uBC0F \uACF5\uACA9\uC744 \uC815\uC9C0\uC2DC\uD0A4\uB294 \uBE59\uACB0
      \uD6A8\uACFC\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4.\r\n### 2.3 \uD50C\uB7AB\uD3FC
      \uD2B9\uD654 \uC815\uB839 (2026-08-18 \uAC1C\uBCC4 \uC815\uB9AC: \uC810\uD504\uB825\uAC15\uD654/\uC774\uC18D\uC99D\uAC00/\uC7A5\uB9C9\uC81C\uACF5)\r\n\uACF5\uD1B5:
      \uCFE8\uD0C0\uC784 1.0\uCD08 (\uD50C\uB7AB\uD3FC \uC7AC\uC0DD\uC131 \uB300\uAE30\uC2DC\uAC04),
      \uBC1C\uD310 \uD06C\uAE30\uB294 \uAE30\uBCF8 \uC815\uB839\uACFC \uB3D9\uC77C(2.0
      \xD7 0.3 \uC720\uB2DB). `\uBC1C\uD310_\uD655\uC7A5_\uAE30\uD68D\uC11C.md` 1.1\uC808\uC758
      \uC2A4\uD0EF \uBCC0\uD654 \uBC1C\uD310 3\uC885\uACFC \uB3D9\uC77C\uD55C \uD6A8\uACFC\uC785\uB2C8\uB2E4.\r\n####
      \uC810\uD504\uB825 \uAC15\uD654 \uC815\uB839 \u2014 \uB178\uB780\uC0C9\r\n>
      \uC124\uBA85: \uC6D0\uB798 \uC810\uD504 \uB192\uC774\uC758 1.5\uBC30\uB9CC\uD07C
      \uB354 \uB192\uC774 \uB6F0\uAC8C \uD574\uC8FC\uB294 \uC810\uD504\uB825 \uAC15\uD654
      \uBC1C\uD310\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4.\r\n#### \uC774\uC18D \uC99D\uAC00
      \uC815\uB839 \u2014 \uD558\uB298\uC0C9\r\n> \uC124\uBA85: \uBC1F\uACE0 \uB09C
      \uD6C4 3\uCD08 \uB3D9\uC548 \uC774\uB3D9 \uC18D\uB3C4\uC758 1.5\uBC30\uB97C
      \uC81C\uACF5\uD558\uB294 \uC774\uB3D9 \uC18D\uB3C4 \uC99D\uAC00 \uBC1C\uD310\uC744
      \uC124\uCE58\uD569\uB2C8\uB2E4.\r\n#### \uC7A5\uB9C9 \uC81C\uACF5 \uC815\uB839
      \u2014 \uCD08\uB85D\uC0C9\r\n> \uC124\uBA85: \uB370\uBBF8\uC9C0 1\uD68C\uB97C
      \uB9C9\uC544\uC8FC\uB294 \uC7A5\uB9C9 \uC81C\uACF5 \uBC1C\uD310\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4.\r\n---\r\n##
      3. \uBAAC\uC2A4\uD130\r\n### 3.1 \uACF5\uD1B5\r\n| \uC2A4\uD0EF | \uC218\uCE58
      |\r\n|---|---|\r\n| \uCCB4\uB825 | \uADFC\uAC70\uB9AC\uD615 10 / \uC6D0\uAC70\uB9AC\uD615
      8 / \uB514\uBC84\uD504\uD615 6 / \uBCF4\uC2A4 60 |\r\n| \uC774\uB3D9 \uC18D\uB3C4
      | \uADFC\uAC70\uB9AC\uD615 2.0\uC720\uB2DB/\uCD08 / \uC6D0\uAC70\uB9AC\uD615
      1.0\uC720\uB2DB/\uCD08(\uC81C\uC790\uB9AC \uC21C\uCC30 \uC704\uC8FC) / \uB514\uBC84\uD504\uD615
      1.5\uC720\uB2DB/\uCD08 / \uBCF4\uC2A4 1.5\uC720\uB2DB/\uCD08 |\r\n| \uACF5\uACA9\uB825
      | \uD558\uD2B8 1 \uAC10\uC18C\uB85C \uACE0\uC815 (\uBAAC\uC2A4\uD130 \uC885\uB958\uC640
      \uBB34\uAD00\uD558\uAC8C \uC811\uCD09\xB7\uD22C\uC0AC\uCCB4 \uD53C\uACA9 \uC2DC
      \uB3D9\uC77C \u2014 `\uC6D4\uB4DC_\uC2A4\uD14C\uC774\uC9C0_\uAD6C\uC131.md`
      6\uC7A5) |\r\n| \uCFE8\uD0C0\uC784 | \uACF5\uACA9 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04
      1.5\uCD08 (\uACF5\uD1B5 \uAE30\uC900\uAC12, \uBCF4\uC2A4\uB294 3.5\uC808 \uCC38\uACE0)
      |\r\n### 3.2 \uB514\uBC84\uD504\uD615 \uCD94\uAC00 \uC2A4\uD0EF\r\n| \uC2A4\uD0EF
      | \uC218\uCE58 |\r\n|---|---|\r\n| \uB514\uBC84\uD504 \uC885\uB958 | \uC2AC\uB77C\uC784
      \uC811\uCD09 \uC2DC \uC0C1\uD0DC\uC774\uC0C1 \"\uB454\uD654\" \uBD80\uC5EC
      (\uC0C1\uC138 \uC218\uCE58\uB294 4.1\uC808 \uCC38\uACE0) |\r\n| \uACF5\uACA9
      \uBC94\uC704 | \uADFC\uC811 \uC811\uCD09\uD615, \uD310\uC815 \uBC94\uC704 0.5\uC720\uB2DB
      |\r\n### 3.3 \uADFC\uAC70\uB9AC\uD615 \uCD94\uAC00 \uC2A4\uD0EF\r\n\uACF5\uD1B5
      \uC2A4\uD0EF(3.1)\uB9CC \uC0AC\uC6A9\uD569\uB2C8\uB2E4 (\uCD94\uAC00 \uC2A4\uD0EF
      \uC5C6\uC74C).\r\n### 3.4 \uC6D0\uAC70\uB9AC\uD615 \uCD94\uAC00 \uC2A4\uD0EF\r\n|
      \uC2A4\uD0EF | \uC218\uCE58 |\r\n|---|---|\r\n| \uACF5\uACA9 \uBC94\uC704 |
      \uAC10\uC9C0 \uBC94\uC704 5.0\uC720\uB2DB / \uBC1C\uC0AC \uC0AC\uAC70\uB9AC
      4.0\uC720\uB2DB |\r\n| \uD22C\uC0AC\uCCB4 \uC885\uB958 | \uB2E8\uC77C \uC9C1\uC120
      \uD22C\uC0AC\uCCB4 (\uC2A4\uCF08\uB808\uD1A4: \uD654\uC0B4) \u2014 \uD22C\uC0AC\uCCB4
      \uC18D\uB3C4 8.0\uC720\uB2DB/\uCD08 |\r\n| \uBC1C\uC0AC \uBC29\uC2DD | \uD50C\uB808\uC774\uC5B4
      \uC704\uCE58\uB97C \uC870\uC900\uD574 \uC9C1\uC120\uC73C\uB85C \uBC1C\uC0AC,
      \uBC1C\uC0AC \uD6C4 \uCFE8\uD0C0\uC784(3.1\uC808 \uAE30\uC900 1.5\uCD08) \uB3D9\uC548
      \uC7AC\uC7A5\uC804 |\r\n### 3.5 \uBCF4\uC2A4 \uCD94\uAC00 \uC2A4\uD0EF\r\n|
      \uC2A4\uD0EF | \uC218\uCE58 |\r\n|---|---|\r\n| \uACF5\uACA9 \uBC94\uC704 |
